/**
 * 16-way Or gate: out = in[0] or in[1] or ... or in[15].
 */

CHIP Or16Way {

    IN  in[16];
    OUT out;

    PARTS:
    Nand(a=in[0], b=in[0], out=n0);
    Nand(a=in[1], b=in[1], out=n1);
    Nand(a=n0, b=n1, out=sr1);
    Nand(a=sr1, b=sr1,out=nsr1);
    Nand(a=in[2], b=in[2], out=n2);
    Nand(a=nsr1, b=n2, out=sr2);
    Nand(a=sr2, b=sr2,out=nsr2);
    Nand(a=in[3], b=in[3], out=n3);
    Nand(a=nsr2, b=n3, out=sr3);
    Nand(a=sr3, b=sr3,out=nsr3);
    Nand(a=in[4], b=in[4], out=n4);
    Nand(a=nsr3, b=n4, out=sr4);
    Nand(a=sr4, b=sr4,out=nsr4);
    Nand(a=in[5], b=in[5], out=n5);
    Nand(a=nsr4, b=n5, out=sr5);
    Nand(a=sr5, b=sr5,out=nsr5);
    Nand(a=in[6], b=in[6], out=n6);
    Nand(a=nsr5, b=n6, out=sr6);
    Nand(a=sr6, b=sr6,out=nsr6);
    Nand(a=in[7], b=in[7], out=n7);
    Nand(a=nsr6, b=n7, out=sr7);
    Nand(a=sr7, b=sr7,out=nsr7);
    Nand(a=in[8], b=in[8], out=n8);
    Nand(a=nsr7, b=n8, out=sr8);
    Nand(a=sr8, b=sr8,out=nsr8);
    Nand(a=in[9], b=in[9], out=n9);
    Nand(a=nsr8, b=n9, out=sr9);
    Nand(a=sr9, b=sr9,out=nsr9);
    Nand(a=in[10], b=in[10], out=n10);
    Nand(a=nsr9, b=n10, out=sr10);
    Nand(a=sr10, b=sr10,out=nsr10);
    Nand(a=in[11], b=in[11], out=n11);
    Nand(a=nsr10, b=n11, out=sr11);
    Nand(a=sr11, b=sr11,out=nsr11);
    Nand(a=in[12], b=in[12], out=n12);
    Nand(a=nsr11, b=n12, out=sr12);
    Nand(a=sr12, b=sr12,out=nsr12);
    Nand(a=in[13], b=in[13], out=n13);
    Nand(a=nsr12, b=n13, out=sr13);
    Nand(a=sr13, b=sr13,out=nsr13);
    Nand(a=in[14], b=in[14], out=n14);
    Nand(a=nsr13, b=n14, out=sr14);
    Nand(a=sr14, b=sr14,out=nsr14);
    Nand(a=in[15], b=in[15], out=n15);
    Nand(a=nsr14, b=n15, out=out);
}
