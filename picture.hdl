using System;
using System.Collections.Generic;

namespace ShowPicture
{
    public static class ShowPictureTask
    {
        public static string[] GenerateShowPictureCode(bool[,] pixels)
        {
            var code = new List<string>();
            var height = pixels.GetLength(0);
            var width = pixels.GetLength(1);
            var screenBaseAddress = 16384; 

            for (int y = 0; y < height; y++)
            {
                for (int x = 0; x < width; x += 16)
                {
                    var word = 0;
                    for (int k = 0; k < 16; k++)
                    {
                        if (x + k < width && pixels[y, x + k])
                        {
                            word |= (1 << k);
                        }
                    }
                    if (word == 0) continue;
                    var currentAddress = screenBaseAddress + (y * 32) + (x / 16);
                    if (word == 0xFFFF)
                    {
                        code.Add("@" + currentAddress);
                        code.Add("M=-1");
                    }
                    else if (word == 1)
                    {
                        code.Add("@" + currentAddress);
                        code.Add("M=1");
                    }
                    else
                    {
                        var signedWord = (short)word;

                        if (signedWord > 0)
                        {
                            code.Add("@" + signedWord);
                            code.Add("D=A");
                        }
                        else
                        {
                            code.Add("@" + (~signedWord));
                            code.Add("D=A");
                            code.Add("D=!D");
                        }
                        code.Add("@" + currentAddress);
                        code.Add("M=D");
                    }
                }
            }
            return code.ToArray();
        }
    }
}